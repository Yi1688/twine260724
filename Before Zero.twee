<div class="bz-stage">
  <div class="bz-scene">
    <img class="bz-scene-art" src="Images/00：10.jpg" alt="最后选择">
    <div class="bz-hud">
      <span class="bz-time">00:10</span>
      <span class="bz-place">最后选择</span>
    </div>
    <div class="bz-final-tag">
      <strong>倒计时终盘</strong>
      <b>00:10</b>
